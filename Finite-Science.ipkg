package Finite-Science
version = 0.2.0
authors = "Justin"
brief   = "App + App1 Black-Box Experimental Engine: Flat Space 3 vs HereditaryMSet"

depends = base >= 0.8.0
        , linear
        , FinSc-Box

sourcedir = "src"

modules = FiniteScience
        , FiniteScience.BlackBoxErrors
        , FiniteScience.StreamWork
        , FiniteScience.Settings
        , FiniteScience.FlatSpaceUniverse
        , FiniteScience.HereditaryUniverse
        , FiniteScience.Experiments
        , Main

main       = Main
executable = "finite-science-experiments"
