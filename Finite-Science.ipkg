package Finite-Science
version = 0.6.0
authors = "Justin"
brief   = "Finite-Science: Top-of-Stack Application & Interface Shell over FinSc-Box, FinSc-Space, and FinSc-Lens"

depends = base >= 0.8.0
        , linear
        , FinSc-Box
        , FinSc-Space
        , FinSc-Lens

sourcedir = "src"

modules = FiniteScience
        , FiniteScience.Main

main       = FiniteScience.Main
executable = "finite-science"
