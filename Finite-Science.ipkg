package Finite-Science
version = 0.4.0
authors = "Justin"
brief   = "Finite-Science: Top-of-Stack Multi-Observer Lab & Black-Box Audit Suite"

depends = base >= 0.8.0
        , linear
        , FinSc-Box
        , FinSc-Dynamics
        , FinSc-Lens

sourcedir = "src"

modules = FiniteScience.Lab
        , FiniteScience.BoundaryAudits
        , FiniteScience.LoadAudits
        , FiniteScience.CosmologyAudits
        , FiniteScience
        , Main

main       = Main
executable = "finite-science-audits"
